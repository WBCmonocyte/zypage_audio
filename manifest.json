{
  "manifest_version": 3,
  "name": "Zypage Audio Donate",
  "version": "1.0.0",
  "description": "Kéo thả file audio vào phần Ghi âm trên Zypage để donate, không cần dùng micro.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://zypage.com/*",
        "https://*.zypage.com/*"
      ],
      "css": ["inject.css"],
      "js": ["inject.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
